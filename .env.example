# Copy to .env and fill in secrets — never commit .env
OIDC_CLIENT_SECRET=
SESSION_SIGNING_KEY=
OIDC_ISSUER_URL=https://auth.osmosis.page/application/o/kv/
OIDC_CLIENT_ID=kv-manager
OIDC_REDIRECT_URI=https://kv.osmosis.page/auth/callback
# ── Anti-abuse (failure-based; see DEPLOYMENT.md) ────────────────────────────
# Per-IP daily counter of *auth failures* (resets midnight UTC). Not a volume
# cap on successful traffic — put request-volume limiting in the proxy.
DAILY_RATE_LIMIT=1000
# Consecutive auth failures (per IP, IPv6 bucketed to /64) before a block.
AUTH_FAILURE_THRESHOLD=10
# First temporary block duration; doubles each repeat offense, capped at 30d.
AUTH_BLOCK_BASE_SECS=3600
# Trust the reverse proxy's X-Real-IP. Set false only if the app is reachable
# directly (then the socket peer is used). Default true.
TRUST_PROXY_HEADERS=true

# Zero Trust (WebAuthn PRF) — required when using Zero Trust key type.
# RP_ID must match the domain users visit (no port, no scheme).
# RP_ORIGIN must match the exact origin (scheme + domain + optional port).
WEBAUTHN_RP_ID=kv.osmosis.page
WEBAUTHN_RP_ORIGIN=https://kv.osmosis.page
