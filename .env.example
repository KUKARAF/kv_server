# Copy to .env and fill in secrets — never commit .env
OIDC_CLIENT_SECRET=
SESSION_SIGNING_KEY=
OIDC_ISSUER_URL=https://auth.osmosis.page/application/o/kv/
OIDC_CLIENT_ID=kv-manager
OIDC_REDIRECT_URI=https://kv.osmosis.page/auth/callback
DAILY_RATE_LIMIT=1000

# Zero Trust (WebAuthn PRF) — required when using Zero Trust key type.
# RP_ID must match the domain users visit (no port, no scheme).
# RP_ORIGIN must match the exact origin (scheme + domain + optional port).
WEBAUTHN_RP_ID=kv.osmosis.page
WEBAUTHN_RP_ORIGIN=https://kv.osmosis.page
